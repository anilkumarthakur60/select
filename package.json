{
  "name": "@anilkumarthakur/select",
  "version": "0.0.1",
  "description": "A typed, accessible select component for Vue, React, Svelte, Solid, and Web Components — single, multi, tags, async, grouped. Framework-agnostic core, framework-idiomatic adapters.",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/anilkumarthakur60/vue3-select#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/vue3-select.git"
  },
  "bugs": {
    "url": "https://github.com/anilkumarthakur60/vue3-select/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilkumarthakur60"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.js"
    },
    "./vue/nuxt": {
      "types": "./dist/vue/nuxt.d.ts",
      "import": "./dist/vue/nuxt.js",
      "require": "./dist/vue/nuxt.cjs",
      "default": "./dist/vue/nuxt.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs",
      "default": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid.js",
      "require": "./dist/solid.cjs",
      "default": "./dist/solid.js"
    },
    "./web-component": {
      "types": "./dist/web-component/index.d.ts",
      "import": "./dist/web-component.js",
      "require": "./dist/web-component.cjs",
      "default": "./dist/web-component.js"
    },
    "./style.css": "./dist/select.css",
    "./scss": "./src/styles/index.scss",
    "./scss/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "vue",
    "vue3",
    "react",
    "svelte",
    "solid",
    "web-components",
    "custom-element",
    "select",
    "combobox",
    "multiselect",
    "tags",
    "autocomplete",
    "typescript",
    "accessible",
    "a11y",
    "headless",
    "form",
    "dropdown",
    "tree",
    "tree-select",
    "framework-agnostic"
  ],
  "scripts": {
    "dev": "run-p --print-label dev:vue dev:react dev:svelte dev:solid dev:wc",
    "dev:vue": "vite --config playground/vue/vite.config.ts --open",
    "dev:react": "vite --config playground/react/vite.config.ts --open",
    "dev:svelte": "vite --config playground/svelte/vite.config.ts --open",
    "dev:solid": "vite --config playground/solid/vite.config.ts --open",
    "dev:wc": "vite --config playground/web-component/vite.config.ts --open",
    "build": "run-s type-check build:lib",
    "build:lib": "vite build",
    "build:demo": "npm run build:demo:vue",
    "build:demo:all": "run-s build:demo:vue build:demo:react build:demo:svelte build:demo:solid build:demo:wc",
    "build:demo:vue": "vite build --config playground/vue/vite.config.ts --outDir ../../dist-demo/vue --emptyOutDir",
    "build:demo:react": "vite build --config playground/react/vite.config.ts --outDir ../../dist-demo/react --emptyOutDir",
    "build:demo:svelte": "vite build --config playground/svelte/vite.config.ts --outDir ../../dist-demo/svelte --emptyOutDir",
    "build:demo:solid": "vite build --config playground/solid/vite.config.ts --outDir ../../dist-demo/solid --emptyOutDir",
    "build:demo:wc": "vite build --config playground/web-component/vite.config.ts --outDir ../../dist-demo/web-component --emptyOutDir",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli \"src/**/*.{ts,tsx,scss}\" \"playground/**/*.{ts,tsx,vue,svelte}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check --experimental-cli \"src/**/*.{ts,tsx,scss}\" \"playground/**/*.{ts,tsx,vue,svelte}\" \"tests/**/*.{ts,tsx}\"",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "ci": "run-s lint format:check test build size",
    "commitlint": "commitlint --edit",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "prepublishOnly": "run-s lint format:check test build",
    "prepare": "husky"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.0.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "nuxt": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^5.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@nuxt/kit": "^4.4.2",
    "@nuxt/schema": "^4.4.7",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.8",
    "@vue/tsconfig": "^0.9.1",
    "commit-and-tag-version": "^12.7.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sass": "^1.99.0",
    "size-limit": "^12.1.0",
    "solid-js": "1.9.12",
    "svelte": "5.55.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "size-limit": [
    {
      "name": "Core (framework-free, gzipped)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "5 kB"
    },
    {
      "name": "Vue adapter (gzipped)",
      "path": "dist/vue.js",
      "import": "*",
      "limit": "13 kB",
      "ignore": [
        "vue",
        "@floating-ui/vue"
      ]
    },
    {
      "name": "React adapter (gzipped)",
      "path": "dist/react.js",
      "import": "*",
      "limit": "8 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "Svelte adapter (gzipped)",
      "path": "dist/svelte.js",
      "import": "*",
      "limit": "6 kB",
      "ignore": [
        "svelte"
      ]
    },
    {
      "name": "Solid adapter (gzipped)",
      "path": "dist/solid.js",
      "import": "*",
      "limit": "6 kB",
      "ignore": [
        "solid-js"
      ]
    },
    {
      "name": "Web Component (gzipped)",
      "path": "dist/web-component.js",
      "import": "*",
      "limit": "8 kB"
    },
    {
      "name": "CSS (gzipped)",
      "path": "dist/select.css",
      "limit": "3.5 kB"
    }
  ],
  "commit-and-tag-version": {
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n\nThe format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),\nand this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).\n",
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "refactor",
        "section": "Refactors"
      },
      {
        "type": "revert",
        "section": "Reverts"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "build",
        "hidden": true
      },
      {
        "type": "ci",
        "hidden": true
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ]
  }
}
