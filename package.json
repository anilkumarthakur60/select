{
  "name": "select",
  "private": true,
  "type": "module",
  "description": "Monorepo for @anil-labs/select — a typed, accessible select/combobox for Vue, React, Svelte, Solid and Web Components. Framework-agnostic core, framework-idiomatic adapters.",
  "license": "MIT",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/select.git"
  },
  "homepage": "https://github.com/anilkumarthakur60/select#readme",
  "bugs": {
    "url": "https://github.com/anilkumarthakur60/select/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilkumarthakur60"
  },
  "scripts": {
    "clean": "pnpm -r --parallel run clean",
    "build": "pnpm --filter \"./packages/**\" run build",
    "build:examples": "pnpm --filter \"./examples/*\" run build",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "test:coverage": "pnpm -r --filter \"./packages/**\" run test:coverage",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:preview": "pnpm --filter docs run preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "build:demos": "node scripts/build-demos.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.67.0",
    "prettier-plugin-svelte": "^3.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.0"
}
