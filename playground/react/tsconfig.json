{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["**/*.ts", "**/*.tsx", "../shared/**/*"],
  "exclude": [],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "types": ["react", "react-dom", "node"],
    "paths": {
      "@": ["../../src/index.ts"],
      "@/*": ["../../src/*"]
    },
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.playground-react.tsbuildinfo"
  }
}
