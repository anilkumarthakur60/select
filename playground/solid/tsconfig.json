{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["**/*.ts", "**/*.tsx", "../shared/**/*"],
  "exclude": [],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "paths": {
      "@": ["../../src/index.ts"],
      "@/*": ["../../src/*"]
    },
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.playground-solid.tsbuildinfo"
  }
}
