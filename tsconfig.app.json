{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "playground/shared/**/*",
    "playground/vue/**/*",
    "playground/vue/**/*.vue",
    "tests/**/*"
  ],
  "exclude": [
    "playground/react/**/*",
    "playground/svelte/**/*",
    "playground/solid/**/*",
    "playground/web-component/**/*"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@": ["./src/index.ts"],
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
