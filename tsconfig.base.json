{
  // Mirrors what this codebase was actually written against: the settings from
  // `@vue/tsconfig/tsconfig.dom.json` plus the `noUncheckedIndexedAccess` the
  // old `tsconfig.lib.json` added. Deliberately NOT stricter than that — the
  // monorepo split should preserve semantics, and flags like
  // `exactOptionalPropertyTypes` (which the Vue preset leaves commented out as
  // "hard to land in the current ecosystem") or
  // `noPropertyAccessFromIndexSignature` would force unrelated src rewrites.
  // Tightening them is worth doing, but as its own change with its own tests.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",

    "strict": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,

    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
